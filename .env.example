# 이메일 발송 설정
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password          # Gmail: 앱 비밀번호 (2단계 인증 후 발급)
EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com
SMTP_HOST=smtp.gmail.com                  # 기본값, 변경 불필요
SMTP_PORT=465                             # 기본값, 변경 불필요

# Claude API (분석 모듈용)
ANTHROPIC_API_KEY=your_anthropic_api_key

# DB 경로
DB_PATH=./data/notices.db

# 크롤링 간격 (분)
CRAWL_INTERVAL_MINUTES=60

# 관리자 웹 페이지(admin_web.py) 로그인 계정
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# .go.kr 사이트(moel/kdca/law/mpm) 우회용 AWS Lambda 릴레이 (선택, GitHub Actions에서만 필요)
# 로컬에서는 비워두면 그냥 직접 접속함
LAMBDA_RELAY_URL=
LAMBDA_RELAY_SECRET=
